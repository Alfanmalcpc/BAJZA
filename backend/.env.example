# BAJA Backend Environment Variables Example
PORT=5000
GEMINI_API_KEY=your_gemini_api_key_here
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here

# Firebase Backend Secure Gateway Credentials (Server-Side Only - NEVER expose to frontend)
FIREBASE_ACCOUNT_API_KEY=your_firebase_account_api_key
FIREBASE_ACCOUNT_DB_URL=https://baja-account-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_ACCOUNT_PROJECT_ID=baja-account

FIREBASE_TWIBBON_API_KEY=your_firebase_twibbon_api_key
FIREBASE_TWIBBON_DB_URL=https://baja-twibon-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_TWIBBON_PROJECT_ID=baja-twibon

FIREBASE_PET_API_KEY=your_firebase_pet_api_key
FIREBASE_PET_DB_URL=https://baja-pet-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_PET_PROJECT_ID=baja-pet

FIREBASE_MULTIPLAY_API_KEY=your_firebase_multiplay_api_key
FIREBASE_MULTIPLAY_DB_URL=https://baja-multiplay-photobooth-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_MULTIPLAY_PROJECT_ID=baja-multiplay-photobooth

FIREBASE_IOT_API_KEY=your_firebase_iot_api_key
FIREBASE_IOT_DB_URL=https://baja-iot-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_IOT_PROJECT_ID=baja-iot
